# Google OAuth — Gmail Import
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
TOKEN_ENCRYPTION_KEY=generate-a-32-char-hex-key-here

# App URL (for OAuth redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (auth backend — Fase 1)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<your-publishable-key>
# SUPABASE_DB_PASSWORD= solo local, nunca commitear
